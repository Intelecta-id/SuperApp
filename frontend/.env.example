# Next.js Supabase Public Client Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Server-side / Route Handlers only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Meta Graph API (Instagram DM Webhook)
META_VERIFY_TOKEN=intelecta_meta_verify_secret
META_APP_SECRET=your-meta-app-secret

# Corporate Webhook Shared Secret
CORPORATE_WEB_SECRET=intelecta_corp_web_secret

# AI Copilot (OpenAI / Gemini)
OPENAI_API_KEY=your-openai-api-key
